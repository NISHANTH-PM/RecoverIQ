# RecoverIQ environment configuration
#
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# LLM intent understanding (optional)
# ---------------------------------------------------------------------------
# When unset, the agent falls back to the deterministic intent classifier
# in src/ai/intent.ts. When set, src/ai/llm.ts uses OpenRouter to interpret
# free-form customer messages that the deterministic classifier marks
# "unclear".
#
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
